{"_doc": "tools/scan_legacy.py 用的 pattern。severity: break=9.1 已回 404/400，必改；deprecated=9.1 仍可用但已棄用，建議改；info=提醒。",
 "patterns": [
  {"id": "vsphere-rest-facade", "regex": "/rest/(com/vmware/cis|vcenter|appliance|content)/", "severity": "deprecated",
   "component": "vCenter", "why": "/rest/ 是 vSphere 6.5–8 的 facade，9.1 仍 200 但已 deprecated；回應多一層 {\"value\": ...}",
   "target": "改用 /api/ 前綴（/api/session、/api/vcenter/vm），回應是裸 list/字串", "playbook": "docs/playbooks/vsphere-rest.md"},
  {"id": "vrops-token-scheme", "regex": "vRealizeOpsToken", "severity": "deprecated",
   "component": "VCF Operations", "why": "vROps 8 的 Authorization scheme；9.1 相容但官方是 OpsToken",
   "target": "Authorization: OpsToken <token>", "playbook": "docs/playbooks/vrops-to-ops.md"},
  {"id": "vra8-csp-login", "regex": "/csp/gateway/am/api/login", "severity": "break",
   "component": "VCF Automation", "why": "vRA 8 帳密登入；VCFA 9 回 404",
   "target": "POST /cloudapi/1.0.0/sessions（Basic user@org:pw，token 在回應標頭 X-VMWARE-VCLOUD-ACCESS-TOKEN）或 POST /oauth/tenant/{org}/token", "playbook": "docs/playbooks/vra-to-vcfa.md"},
  {"id": "vra8-iaas-login", "regex": "/iaas/api/login", "severity": "break",
   "component": "VCF Automation", "why": "端點在但 refresh token 交換回 400 invalid_grant",
   "target": "同上", "playbook": "docs/playbooks/vra-to-vcfa.md"},
  {"id": "vra8-csp-token-field", "regex": "cspAuthToken", "severity": "break",
   "component": "VCF Automation", "why": "csp 回應欄位，VCFA 9 沒有", "target": "改讀 X-VMWARE-VCLOUD-ACCESS-TOKEN 標頭或 access_token", "playbook": "docs/playbooks/vra-to-vcfa.md"},
  {"id": "nsx-logical-switches", "regex": "/api/v1/logical-switches", "severity": "break",
   "component": "NSX", "why": "NSX-V/MP 舊世代端點，9.1 回 404", "target": "GET /policy/api/v1/infra/segments", "playbook": "docs/playbooks/nsx-mp-to-policy.md"},
  {"id": "nsx-logical-routers", "regex": "/api/v1/logical-routers", "severity": "break",
   "component": "NSX", "why": "9.1 回 404", "target": "/policy/api/v1/infra/tier-0s 或 tier-1s", "playbook": "docs/playbooks/nsx-mp-to-policy.md"},
  {"id": "nsx-firewall-sections", "regex": "/api/v1/firewall/sections", "severity": "break",
   "component": "NSX", "why": "9.1 回 404", "target": "GET /policy/api/v1/infra/domains/{domain}/security-policies", "playbook": "docs/playbooks/nsx-mp-to-policy.md"},
  {"id": "nsx-ns-groups", "regex": "/api/v1/ns-(groups|services)", "severity": "break",
   "component": "NSX", "why": "9.1 回 404", "target": "/policy/api/v1/infra/domains/{domain}/groups 或 /policy/api/v1/infra/services", "playbook": "docs/playbooks/nsx-mp-to-policy.md"},
  {"id": "loginsight-v1", "regex": "/api/v1/(events|sessions|aggregated-events)\\b", "severity": "break",
   "component": "Operations for Logs", "why": "vRealize Log Insight v1 API；VCF 9 改為 Log Management /api/v2（本 lab 未部署，未實測）",
   "target": "POST /api/v2/logs/search（Bearer）", "playbook": "docs/rules.md#log-insight"},
  {"id": "vrlcm", "regex": "/lcm/lcops/api/", "severity": "break",
   "component": "SDDC Manager", "why": "vRealize Lifecycle Manager 已移除，生命週期管理改由 SDDC Manager / Fleet LCM 提供",
   "target": "SDDC Manager /v1/* 或 Fleet LCM /v1/*", "playbook": "docs/rules.md#vrlcm"}
 ]}
